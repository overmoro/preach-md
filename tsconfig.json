{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "jsx": "react",
    // ES2018 to match the esbuild target. "types": [] keeps @types/node from
    // widening it, so tsc and lint see the APIs the community review scan sees.
    "lib": ["ES2018", "DOM"],
    "types": [],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
